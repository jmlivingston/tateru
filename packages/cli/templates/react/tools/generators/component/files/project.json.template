{
  "name": "<%= propertyName %>",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/<%= className %>/src",
  "projectType": "library",
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write .",
        "cwd": "packages/<%= className %>"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project <%= npmScope %>/<%= fileName %>"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --fix --cache --cache-location node_modules/.cache/eslint/ packages/<%= className %>"
      }
    },
    "lint-style": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint --fix \"**/*.css\"",
        "cwd": "packages/<%= className %>"
      }
    }
  }
}