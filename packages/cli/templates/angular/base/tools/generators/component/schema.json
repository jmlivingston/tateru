{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name in PascalCase",
      "pattern": "^[A-Z][a-zA-Z0-9]*$",
      "x-prompt": "Component name (PascalCase):"
    },
    "language": {
      "type": "string",
      "description": "Angular components use TypeScript",
      "enum": ["typescript"],
      "default": "typescript"
    }
  },
  "required": ["name"]
}
