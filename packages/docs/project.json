{
  "name": "@tateru/docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/.vitepress/dist"],
      "options": {
        "command": "npm run build --workspace=@tateru/docs"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev --workspace=@tateru/docs"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run preview --workspace=@tateru/docs"
      }
    }
  }
}
